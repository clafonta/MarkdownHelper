{
  "name": "markdown-helper",
  "version": "0.1.0",
  "description": "A lightweight two-pane Markdown editor",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "prestart": "node scripts/vendor.js && node scripts/brand-dev-electron.js",
    "start": "electron .",
    "postinstall": "node scripts/vendor.js && node scripts/brand-dev-electron.js",
    "test": "node --test test/",
    "assets": "electron scripts/make-assets.js",
    "predist": "node scripts/vendor.js",
    "dist": "electron-builder --mac --arm64 --x64",
    "predist:arm64": "node scripts/vendor.js",
    "dist:arm64": "electron-builder --mac --arm64",
    "predist:x64": "node scripts/vendor.js",
    "dist:x64": "electron-builder --mac --x64"
  },
  "dependencies": {
    "dompurify": "^3.5.0",
    "marked": "^18.3.0"
  },
  "devDependencies": {
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "mermaid": "^12.3.0"
  },
  "productName": "Markdown Helper",
  "author": "Chad Lafontaine",
  "build": {
    "appId": "com.markdownhelper.app",
    "productName": "Markdown Helper",
    "copyright": "Copyright © 2026 Chad Lafontaine",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": "-",
      "artifactName": "Markdown-Helper-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mdx"
        ],
        "name": "Markdown Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "TSV Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "txt"
        ],
        "name": "Plain Text Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "json"
        ],
        "name": "JSON Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "html",
          "htm"
        ],
        "name": "HTML Document",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "svg"
        ],
        "name": "SVG Image",
        "role": "Editor",
        "rank": "Alternate"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Mermaid Diagram",
        "role": "Editor",
        "rank": "Alternate"
      }
    ],
    "dmg": {
      "title": "Markdown Helper",
      "background": "build/background.png",
      "window": {
        "width": 540,
        "height": 380
      },
      "iconSize": 96,
      "contents": [
        {
          "x": 140,
          "y": 160,
          "type": "file"
        },
        {
          "x": 400,
          "y": 160,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  }
}
