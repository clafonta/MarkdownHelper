# Dependencies (restored by `npm install`)
node_modules/

# Build output from `npm run dist` (.app, .dmg, .zip, .blockmap, builder configs)
dist/
out/
screenshots/

# Logs and debug output
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/

# Test coverage
coverage/
.nyc_output/

# Environment / secrets (e.g. Apple signing & notarization credentials)
.env
.env.*
*.p12
*.cer
*.provisionprofile

# Editors and IDEs
.idea/
.vscode/
*.swp
*~

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Claude Code local settings
.claude/settings.local.json

# Note: build/*.png, build/icon.icns and build/background*.png are generated by `npm run assets`
# but are committed on purpose, since electron-builder reads them directly at package time.
